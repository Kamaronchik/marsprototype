# ==========================================
# Mars Space CRM - Environment Variables
# ==========================================

# Supabase (PostgreSQL Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Security Secret (Used for hashing verification codes)
HMAC_SECRET=your-secure-random-secret-key

# Email 2FA (Gmail App Password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Server Port (Local Development)
PORT=5000

# Client URL (For CORS during local development)
CLIENT_URL=http://localhost:5173

# Telegram AI assistant (bot token from @BotFather, random secret for the webhook)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
