# Mars Space CRM: all environment variables, without values.
# Copy this file to .env and fill it in. The .env file is in .gitignore: never commit it.
# On Vercel the same names go to Project Settings -> Environment Variables.

# --- Database (Supabase) -----------------------------------------------------
# Project settings -> API. The secret key is the "service_role" key: server only, never in the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Security ----------------------------------------------------------------
# A long random string. Used to hash the e-mail codes (2FA and purchases).
# Changing it makes all codes that were already sent invalid.
HMAC_SECRET=

# --- E-mail codes (Gmail) ----------------------------------------------------
# Gmail address and an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# --- Addresses ---------------------------------------------------------------
# Local server port.
PORT=
# The address of the site, for CORS. Local: http://localhost:5173
CLIENT_URL=
# The address of the future Careers site (it sends applications to POST /api/careers/apply). Optional.
CAREERS_URL=

# --- Telegram bot ------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# A random secret: Telegram sends it in a header with every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# The bot name without @ (for the connect link). Optional.
TELEGRAM_BOT_USERNAME=
# How many AI answers one student gets in the bot per day. Optional.
AI_DAILY_LIMIT=

# --- AI (Google Gemini) ------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The model name. Optional.
GEMINI_MODEL=

# --- Audit rules timer -------------------------------------------------------
# A long random string. A timer (Vercel Cron or any pinger, every 5 minutes) calls
# GET /api/cron/rules with the header  Authorization: Bearer <this value>.
# Without it the endpoint is off; the rules still run while people use the site.
CRON_SECRET=

# Firebase push notifications (penalties come to the teacher's browser)
# Web config: Firebase console -> Project settings -> General -> Your apps (public values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings -> Cloud Messaging -> Web Push certificates -> Key pair
VITE_FIREBASE_VAPID_KEY=
# SECRET. Project settings -> Service accounts -> Generate new private key; the whole JSON on one line
FIREBASE_SERVICE_ACCOUNT=
